# IT 자산관리 시스템 설정 예시
#
# Docker 로 배포한다면 이 파일을 직접 쓸 필요가 없습니다.
#   ./deploy.sh setup
# 을 실행하면 안전한 세션 키와 관리자 비밀번호가 들어간 .env 가 자동으로 만들어집니다.
#
# 직접 작성할 경우 이 파일을 .env 로 복사해 값을 채우세요.
# (.env 는 비밀 값을 담고 있어 git 에 올라가지 않습니다.)

# ── 필수 ───────────────────────────────────────────────────────
# 세션 서명 키. 지정하지 않으면 재시작할 때마다 모든 로그인이 풀립니다.
#   python -c "import secrets; print(secrets.token_hex(32))"
ITAM_SECRET_KEY=여기에_긴_임의_문자열을_넣으세요

# ── 접속 ───────────────────────────────────────────────────────
# 서버 바깥에서 접속할 포트. http://<서버IP>:<이 포트> 로 접속합니다.
ITAM_PUBLIC_PORT=8000

# 사내 도메인 + HTTPS 로 전환하면 1 로 바꾸세요 (deploy/README-HTTPS.md 참고)
ITAM_HTTPS_ONLY=0

# ── 최초 관리자 계정 (첫 로그인 후 화면에서 변경하세요) ──────────
ITAM_ADMIN_USERNAME=admin
ITAM_ADMIN_PASSWORD=변경하세요

# ── 운영 옵션 ──────────────────────────────────────────────────
# 워커 프로세스 수 (직원 100명 규모면 2개로 충분합니다)
ITAM_WORKERS=2

# 목록 한 페이지 행 수
ITAM_PAGE_SIZE=20

# 로그인 유지 시간(초). 기본 12시간.
ITAM_SESSION_MAX_AGE=43200

# 엑셀 업로드 최대 크기(바이트). 기본 10MB.
ITAM_MAX_UPLOAD_BYTES=10485760

# ── 데이터베이스 ───────────────────────────────────────────────
# Docker 로 실행하면 컨테이너 안 /data/itam.db 가 자동으로 사용됩니다.
# 직접 실행할 때의 기본값은 ./data/itam.db 입니다.
# PostgreSQL 로 옮길 때만 아래 주석을 해제하세요.
# ITAM_DATABASE_URL=postgresql+psycopg://itam:비밀번호@db-host:5432/itam
