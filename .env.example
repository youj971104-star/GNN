# 운영 환경에서 사용할 설정 예시입니다.
# 이 파일을 .env 로 복사한 뒤 값을 채우고, 서비스 실행 시 환경변수로 넣어 주세요.
# (.env 파일 자체는 git 에 올라가지 않습니다.)

# 세션 서명 키 - 반드시 바꾸세요. 아래 명령으로 생성할 수 있습니다.
#   python -c "import secrets; print(secrets.token_hex(32))"
ITAM_SECRET_KEY=여기에_긴_임의_문자열을_넣으세요

# 데이터베이스. 기본은 data/itam.db (SQLite).
# PostgreSQL 로 옮길 때는 아래 형식으로 바꾸면 됩니다.
#   ITAM_DATABASE_URL=postgresql+psycopg://user:password@db-host:5432/itam
# ITAM_DATABASE_URL=sqlite:////var/lib/itam/itam.db

# 최초 실행 시 자동 생성되는 관리자 계정 (첫 로그인 후 비밀번호를 변경하세요)
ITAM_ADMIN_USERNAME=admin
ITAM_ADMIN_PASSWORD=변경하세요

# 서버 주소/포트
ITAM_HOST=0.0.0.0
ITAM_PORT=8000

# 목록 한 페이지에 보여줄 행 수
ITAM_PAGE_SIZE=20

# 로그인 세션 유지 시간(초). 기본 12시간.
ITAM_SESSION_MAX_AGE=43200

# 엑셀 업로드 최대 크기(바이트). 기본 10MB.
ITAM_MAX_UPLOAD_BYTES=10485760
